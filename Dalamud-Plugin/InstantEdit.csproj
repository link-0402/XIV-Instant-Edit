<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>InstantEdit</RootNamespace>
    <AssemblyName>InstantEdit</AssemblyName>
    <Version>3.0.0</Version>
    <FileVersion>3.0.0</FileVersion>
    <!-- The oldest Blender add-on and Painter plugin this build works with. Raise one only when the plugin needs that component's newer code. -->
    <BlenderAddonMinimumVersion>3.0.0</BlenderAddonMinimumVersion>
    <PainterPluginMinimumVersion>3.0.0</PainterPluginMinimumVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudDevPath Condition="Exists('$(APPDATA)\XIVLauncher\addon\Hooks\dev\Dalamud.dll')">$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudDevPath>
    <DalamudDevPath Condition="'$(DalamudDevPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks</DalamudDevPath>
  </PropertyGroup>

  <PropertyGroup>
    <Author>Luci_xiv</Author>
    <Name>XIV Instant Edit</Name>
    <Punchline>Send on-screen models straight to Blender and back.</Punchline>
    <Description>Allows for easy and instant editing of Penumbra model files in Blender and saving them right back to the game. Model editing uses the XIV Instant Edit Blender add-on, which the first-time setup installs for you. The Mod Browser opens any Penumbra mod to see and change its files, and builds new modpacks.</Description>
    <RepoUrl>https://github.com/link-0402/XIV-Instant-Edit</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/link-0402/XIV-Instant-Edit/main/Dalamud-Plugin/images/icon.png</IconUrl>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <LoadRequiredState>0</LoadRequiredState>
    <LoadSync>true</LoadSync>
    <CanUnloadAsync>false</CanUnloadAsync>
    <LoadPriority>0</LoadPriority>
    <AcceptsFeedback>false</AcceptsFeedback>
    <Tags>penumbra,blender,modding,model,utility</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DalamudPackager" Version="15.0.0" GeneratePathProperty="true" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
    <!-- Managed Ogg Vorbis decoder (MIT) for sound import; CopyLocalLockFileAssemblies ships NVorbis.dll in the plugin. -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- The Mod Browser's texture conversion and image reading, and the Sims 4 importer's mesh export. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!--
    ImageSharp 4 needs a paid license key to build, so the Mod Browser stays on 3.1 (Six Labors
    Split License, free for open source). Its open advisories are in TIFF encoding, BigTIFF and ICC
    profile decoding, and histogram equalization. The plugin never encodes TIFF or equalizes, and it
    decodes only through Studio/Services/StudioImages.cs: no TIFF decoder, and metadata (ICC
    profiles included) skipped. Drop these suppressions when moving to a version without them.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Mod Browser's bundled material presets (from TexTools), read from beside the DLL. -->
    <None Include="Studio\Resources\MaterialPresets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudDevPath)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudDevPath)\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImPlot">
      <HintPath>$(DalamudDevPath)\Dalamud.Bindings.ImPlot.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGuizmo">
      <HintPath>$(DalamudDevPath)\Dalamud.Bindings.ImGuizmo.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudDevPath)\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudDevPath)\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudDevPath)\Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudDevPath)\Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudDevPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Direct3D 11 bindings, for views over single slices of the game's texture arrays (the material editor's thumbnails). -->
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudDevPath)\TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\Animations\TmbLayouts.json" />
    <!-- The Bones window's body artwork, from Brio (GPL-3.0); see THIRD-PARTY-NOTICES.md. -->
    <EmbeddedResource Include="Resources\Pose\*.png" LogicalName="InstantEdit.Pose.%(Filename)%(Extension)" />
    <!-- The Substance Painter plugin, installed from Settings. Its PLUGIN_VERSION is its own version (see ComponentVersions). -->
    <EmbeddedResource Include="..\Tools\SubstancePainter\xiv_instant_edit\*.py" LogicalName="InstantEdit.PainterPlugin.%(Filename)%(Extension)" />
    <!-- Run by setup in a windowless Blender to add the GitHub extension repository and install the add-on. -->
    <EmbeddedResource Include="Services\Setup\install_blender_addon.py" LogicalName="InstantEdit.Setup.install_blender_addon.py" />
    <!-- The add-on's manifest, for the Blender versions setup offers to install into. -->
    <EmbeddedResource Include="..\Blender-Addon\blender_manifest.toml" LogicalName="InstantEdit.Setup.blender_manifest.toml" />
    <!-- The Save Flattened TGA scripts, installed into the texture editors from setup and Settings. -->
    <EmbeddedResource Include="..\Tools\Photoshop\*.jsx" LogicalName="InstantEdit.EditorScripts.Photoshop.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Tools\GIMP\*.scm" LogicalName="InstantEdit.EditorScripts.GIMP.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Tools\Krita\Plugin\save_flattened_tga.desktop" LogicalName="InstantEdit.EditorScripts.Krita.save_flattened_tga.desktop" />
    <EmbeddedResource Include="..\Tools\Krita\Plugin\save_flattened_tga\*.py" LogicalName="InstantEdit.EditorScripts.Krita.save_flattened_tga/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Read by ComponentVersions. -->
  <ItemGroup>
    <AssemblyMetadata Include="BlenderAddonMinimumVersion" Value="$(BlenderAddonMinimumVersion)" />
    <AssemblyMetadata Include="PainterPluginMinimumVersion" Value="$(PainterPluginMinimumVersion)" />
  </ItemGroup>

  <!-- Dalamud reads a dev plugin's installer icon from images\icon.png beside the DLL; DalamudPackager leaves it out of latest.zip. -->
  <ItemGroup>
    <None Update="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    AppendTargetFrameworkToOutputPath is disabled because DalamudPackager
    expects the plugin files at the output root. Older builds can leave
    target-framework folders beside that output; remove them before packaging
    so host-provided Dalamud assemblies are not shipped in the install ZIP.
  -->
  <Target Name="CleanStaleTargetFrameworkOutput"
          BeforeTargets="DefaultDalamudPackagerDebug;DefaultDalamudPackagerRelease">
    <RemoveDir Directories="$(OutputPath)net10.0;$(OutputPath)net10.0-windows" />
  </Target>

  <!--
    Copy the published package to the ignored dist folder, where scripts/prepare-release.ps1
    picks it up for the GitHub release (docs/release-packaging.md). It is not committed.
  -->
  <Target Name="CopyReleasePackageToDistribution"
          AfterTargets="DefaultDalamudPackagerRelease"
          Condition="'$(Configuration)' == 'Release' and '$(SkipDistributionPackage)' != 'true'">
    <PropertyGroup>
      <ReleasePackagePath>$(OutputPath)$(AssemblyName)\latest.zip</ReleasePackagePath>
      <DistributionDirectory>$(MSBuildProjectDirectory)\..\dist\InstantEdit</DistributionDirectory>
      <DistributionPackagePath>$(DistributionDirectory)\latest.zip</DistributionPackagePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(ReleasePackagePath)')"
           Text="DalamudPackager did not produce the expected release package: $(ReleasePackagePath)" />
    <MakeDir Directories="$(DistributionDirectory)" />
    <Copy SourceFiles="$(ReleasePackagePath)" DestinationFiles="$(DistributionPackagePath)" />
  </Target>

</Project>
